# Neon Postgres connection string. Must have a `tracking` schema with
# `runs` and `ev` tables — see README.md#database-schema.
DATABASE_URL=

# Google OAuth credentials (console.cloud.google.com/apis/credentials).
# Authorized redirect URI: <your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random secret NextAuth uses to sign session tokens. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# Base URL of the app. http://localhost:3000 in local dev; your deployed
# URL (e.g. https://running-tracker-mu-navy.vercel.app) elsewhere.
NEXTAUTH_URL=http://localhost:3000
